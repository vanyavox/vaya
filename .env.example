# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://vaya:vaya@localhost:5432/vaya

# Auth
JWT_SECRET=change-me-to-a-random-string-min-32-chars
JWT_ACCESS_TTL=15m
# Sliding idle window: session ends after 7 days without a visit
JWT_REFRESH_TTL=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Uploads
UPLOAD_DIR=uploads
MAX_AVATAR_SIZE=2097152
