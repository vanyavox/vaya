# Copy to .env on the server (same folder as docker-compose.prod.yml).
# NEVER commit the real .env.

# Public URL (after DNS is pointed at the VPS)
PUBLIC_URL=https://vaya.example.ru
SITE_NAME=vaya.example.ru

# Optional: asset CDN for hashed /assets/* (Timeweb CDN delivery domain).
# Leave empty for same-origin. If set — set BOTH build (Vite base) and CSP.
# Apex root must NOT be used; only a subdomain, e.g. https://cdn.example.ru
# ASSET_CDN_URL=https://cdn.example.ru

# Database
POSTGRES_USER=vaya
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=vaya

# Auth
JWT_SECRET=change-me-to-a-random-string-min-32-chars
JWT_ACCESS_TTL=15m
# Sliding idle window: session ends after 7 days without a visit
JWT_REFRESH_TTL=7d

# Web Push (VAPID)
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@example.com
